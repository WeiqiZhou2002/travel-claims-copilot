{
  "name": "travel-claims-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib tests --ext .ts,.tsx",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "vitest run",
    "publish:cases": "node scripts/publish-reviewed-cases.mjs",
    "format": "prettier --write app lib tests scripts *.json *.mjs",
    "format:check": "prettier --check app lib tests scripts *.json *.mjs",
    "eval:intake": "node scripts/eval-intake.mjs",
    "prebuild": "npm run validate:data"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "latest",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "latest",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
